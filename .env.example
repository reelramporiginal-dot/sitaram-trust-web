# ROOT PATH: .env.example   (names only - never commit real values)

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Site / admin ----
SITE_URL=                      # https://your-domain (no trailing slash)
ADMIN_EMAILS=                  # comma separated admin logins

# ---- Payment gateway (room bookings) ----
PAYMENT_GATEWAY=cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01
CASHFREE_ENV=sandbox           # sandbox | production
VITE_CASHFREE_ENV=sandbox      # optional cross-check; must equal CASHFREE_ENV
VITE_ONLINE_PAYMENTS=false     # false = Book & Pay opens the OLD enquiry form (admin gets the query). Set true only after the walkthrough passes

# ---- Razorpay (only for admin-made /pay/:token links) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
MAIL_FROM=                     # e.g. "Shri Sitaram Seva Trust <booking@your-domain>" (verify SPF/DKIM/DMARC first)
BOOKING_NOTIFY_EMAIL=
GOOGLE_REVIEW_URL=
WINBACK_ENABLED=false          # true = one win-back mail 90+ days after stay (consenting guests only)

# ---- Invoice ----
INVOICE_GSTIN=
INVOICE_NOTE=
INVOICE_LOGO_URL=

# ---- Cron / bot protection ----
CRON_SECRET=                   # 32+ random characters; endpoints return 503 when unset
TURNSTILE_SECRET_KEY=          # optional (Cloudflare Turnstile)
VITE_TURNSTILE_SITE_KEY=

# ---- Facebook / Instagram auto-post (existing) ----
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
